# Copy these names into Render Environment Variables.
# NEVER commit real secret values to GitHub.

# REQUIRED: your Stripe secret key. Placeholder only.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME

# REQUIRED for normal Stripe webhooks. Placeholder only.
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# REQUIRED for the V2 thin-event Event Destination. Placeholder only.
STRIPE_V2_WEBHOOK_SECRET=whsec_REPLACE_ME

# REQUIRED in production so Account Links and Checkout know where to return.
APP_BASE_URL=https://fitterfield-pro-app.onrender.com

# REQUIRED for durable user -> connected-account mapping.
# Use Render's internal Postgres connection string for the FitterField database.
DATABASE_URL=postgresql://REPLACE_ME

# Platform-level recurring Price used to bill connected accounts.
# A sandbox example was created for this project: price_1UB5dZEk0hZiSTYibNQshVrz
CONNECT_SUBSCRIPTION_PRICE_ID=price_1UB5dZEk0hZiSTYibNQshVrz

# 500 basis points = 5% application fee on direct charges.
CONNECT_APPLICATION_FEE_BPS=500
